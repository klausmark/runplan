# Bind to loopback when a reverse proxy on this host is the only public ingress.
RUNPLAN_HOST_IP=127.0.0.1

# Port exposed on the Docker host.
RUNPLAN_HOST_PORT=8000

# Reference 5K race time (H:MM:SS or M:SS). Drives every personalized pace
# target across the NRC templates; recovery pace becomes the generic
# estimate fallback for unpaced running steps.
RUNPLAN_5K_BEST=30:00

# Seconds per kilometer the Garmin pace zone widens above and below each
# pace target. 0 means a fixed target; 5 is the recommended default.
RUNPLAN_PACE_ZONE=5

# Generate the recommended value with: uv run runplan hash-password
# Treat the verifier as a secret. Set exactly one password option.
RUNPLAN_WEB_PASSWORD_HASH=
# RUNPLAN_WEB_PASSWORD=replace-with-a-shared-password

# Keep HTTPS required for remote access. Set TRUST_PROXY=true only when a
# trusted reverse proxy overwrites X-Forwarded-Proto and is the only ingress.
RUNPLAN_WEB_REQUIRE_HTTPS=true
RUNPLAN_WEB_TRUST_PROXY=false
